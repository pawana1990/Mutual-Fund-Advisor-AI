# --- Core ---
ENVIRONMENT=local                    # local | dev | staging | prod
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Database ---
POSTGRES_USER=wealth_advisor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wealth_advisor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://wealth_advisor:change-me@postgres:5432/wealth_advisor

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage ---
AWS_REGION=ap-south-1
S3_BUCKET_STATEMENTS=ai-wealth-advisor-statements
S3_BUCKET_REPORTS=ai-wealth-advisor-reports
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Auth (AWS Cognito) ---
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=ap-south-1
JWT_ALGORITHM=RS256

# --- LLM / AI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# --- Market data / fund research providers ---
AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
FUND_DATA_PROVIDER_API_KEY=

# --- Notifications ---
SES_FROM_EMAIL=alerts@aiwealthadvisor.app
WHATSAPP_BUSINESS_API_TOKEN=
FCM_SERVER_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=ap-south-1
